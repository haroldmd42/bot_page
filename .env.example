# ==============================================================================
# AUTONOMOUS SOCIAL VIDEO AGENT - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. YOUTUBE DATA API v3 (OAuth2 Client ID + Secret + Refresh Token)
# ------------------------------------------------------------------------------
# Obtenido en Google Cloud Console (APIs & Services > Credentials)
YT_CLIENT_ID=tu_cliente_id_google.apps.googleusercontent.com
YT_CLIENT_SECRET=tu_client_secret_google
# Refresh token obtenido una sola vez mediante script o OAuth Playground
YT_REFRESH_TOKEN=1//04abcdefgh123456789...
# Estado de privacidad del video ('public', 'unlisted', 'private')
YT_PRIVACY_STATUS=public

# ------------------------------------------------------------------------------
# 2. META GRAPH API (FACEBOOK PAGE REELS)
# ------------------------------------------------------------------------------
# ID numérico de tu página de Facebook (Meta Business Suite o URL de la página)
FB_PAGE_ID=123456789012345
# Token de acceso de larga duración con permisos 'pages_manage_posts' y 'pages_read_engagement'
FB_PAGE_ACCESS_TOKEN=EAAG...tu_token_de_pagina_de_larga_duracion...
# Versión de la Graph API (por defecto v19.0)
FB_GRAPH_VERSION=v19.0

# ------------------------------------------------------------------------------
# 3. MODO DE EJECUCIÓN
# ------------------------------------------------------------------------------
# Si es 'true', simula publicaciones en redes sin consumir cuotas de API
DRY_RUN=false
